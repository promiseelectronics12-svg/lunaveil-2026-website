{
  "buildCommand": "npm install --include=dev && npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install --include=dev",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
